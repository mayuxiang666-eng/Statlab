{
  "name": "statlab-server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server/src/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only ./src/index.ts",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"analysis/**/*.ts\"",
    "test": "vitest run",
    "db:push": "prisma db push",
    "build": "tsc -p tsconfig.json",
    "build:exe": "npm run build && set CI=true&& set NODE_TLS_REJECT_UNAUTHORIZED=0&& npx pkg . --targets node18-win-x64 --output release/statlab-server.exe"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@statlab/shared": "file:../shared",
    "apriori": "^1.0.7",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "ml-cart": "^2.1.1",
    "ml-kmeans": "^4.0.0",
    "ml-logistic-regression": "^2.0.0",
    "ml-matrix": "^6.11.2",
    "ml-pca": "^4.1.1",
    "ml-random-forest": "^2.0.1",
    "mssql": "^12.2.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.18.2",
    "node-fpgrowth": "^1.2.1",
    "pdfkit": "^0.13.0",
    "pg": "^8.19.0",
    "simple-statistics": "^7.8.8",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/jsonfile": "^6.1.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/pdfkit": "^0.13.5",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.4.0"
  },
  "pkg": {
    "assets": [
      "assets/**/*",
      "../samples/**/*",
      "../db/**/*",
      "../uploads/**/*",
      "fonts/**/*",
      ".prisma/client/query_engine-windows.dll.node"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "bin": "dist/server/src/index.js"
}
