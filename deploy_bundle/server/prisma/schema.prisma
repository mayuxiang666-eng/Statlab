generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model challengeattempt {
  id          String   @id
  userId      String
  ts          DateTime @default(now())
  courseId    String
  courseTitle String
  score       Int
  passed      Boolean
  correct     Int
  total       Int

  @@index([userId], map: "ChallengeAttempt_userId_fkey")
}

model dataset {
  id               Int      @id @default(autoincrement())
  userId           String?
  name             String
  originalFilename String
  createdAt        DateTime @default(now())

  @@index([userId], map: "Dataset_userId_fkey")
}

model datasetversion {
  id        Int      @id @default(autoincrement())
  datasetId Int
  version   Int
  createdAt DateTime @default(now())
  path      String
  summary   String   @db.LongText

  @@index([datasetId], map: "DatasetVersion_datasetId_fkey")
}

model labexerciserecord {
  id                String   @id
  userId            String
  ts                DateTime @default(now())
  courseId          String
  courseTitle       String
  cellId            String
  cellLabel         String?
  code              String   @db.LongText
  passed            Boolean
  isFinalStep       Boolean
  error             String?  @db.LongText
  checkpointResults String?  @db.LongText
  tests             String?  @db.LongText

  @@index([userId], map: "LabExerciseRecord_userId_fkey")
}

model learningprogress {
  id        Int      @id @default(autoincrement())
  userId    String   @unique(map: "LearningProgress_userId_key")
  score     Int      @default(0)
  completed String   @db.LongText
  badges    String   @db.LongText
  quality   String   @db.LongText
  updatedAt DateTime
}

model runrecord {
  id               Int       @id @default(autoincrement())
  userId           String?
  datasetId        Int?
  datasetVersionId Int?
  algorithmId      String
  variables        String    @db.LongText
  params           String    @db.LongText
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  result           String?   @db.LongText
  log              String?   @db.LongText
  analysisName     String?
  analystName      String?
  isPublic         Boolean   @default(false)
  sharedNote       String?   @db.VarChar(255)
  sharedAt         DateTime? @db.DateTime(0)

  @@index([datasetId], map: "RunRecord_datasetId_fkey")
  @@index([datasetVersionId], map: "RunRecord_datasetVersionId_fkey")
  @@index([userId], map: "RunRecord_userId_fkey")
}

model savedconnection {
  id        String   @id
  userId    String?
  name      String
  type      String
  host      String
  port      Int
  database  String
  user      String
  password  String   @db.LongText
  createdAt DateTime @default(now())

  @@index([userId], map: "SavedConnection_userId_fkey")
}

model user {
  id        String   @id
  username  String   @unique(map: "User_username_key")
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model wrongquestion {
  id             String   @id
  userId         String
  ts             DateTime @default(now())
  courseId       String
  courseTitle    String
  questionId     String
  question       String   @db.LongText
  selectedAnswer String
  correctAnswer  String
  explanation    String   @db.LongText

  @@index([userId], map: "WrongQuestion_userId_fkey")
}
